[Unit]
Description=OpenBot Agent Server Daemon
After=network.target

[Service]
Type=simple
User=openbot
Group=openbot
Environment="HOME=/home/openbot"
Environment="USER=openbot"
Environment="OPENBOT_SERVER=1"
# The server mode needs a runtime directory of its own: the control socket of the server and the
# sockets of the Computer Use driver live in it. Without it the daemon refuses to run in server
# mode and falls back to the desktop, which loads a renderer nobody looks at.
Environment="XDG_RUNTIME_DIR=/run/openbot"
WorkingDirectory=/home/openbot

# Fail-Fast Anti-Hang Memory Policy:
# Avoid MemoryHigh CPU-throttling stall. Hard cap so OOM kills and systemd auto-restarts cleanly.
# The memory guard (src/main/server-memory.ts) measures free memory as the smaller of MemAvailable
# and the free memory of this unit's cgroup, so this cap is also the ceiling of the memory levels.
# A cap that is too small makes the free memory stay under the low threshold (max(512 MiB, 12% of
# the ceiling)) once the turns reserve 300 MiB each. Then the daemon holds every new turn and the
# messages stay in the queue. 6G leaves room for the browser tabs and the agent processes on a
# 16 GB host that also runs the farm.
MemoryMax=6G
TasksMax=infinity
LimitNOFILE=65536

# The runtime directory belongs to the service and is removed with it.
RuntimeDirectory=openbot
RuntimeDirectoryMode=0700

ExecStart=/usr/bin/dbus-run-session -- /home/openbot/start-openbot.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
